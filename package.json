{
  "name": "@frxncisxo/syncwave",
  "version": "1.0.0",
  "description": "Distributed state management with real-time sync, offline-first, and automatic conflict resolution using CRDTs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.esm.js",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./server": {
      "import": "./dist/server.esm.js",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters.esm.js",
      "require": "./dist/adapters.js",
      "types": "./dist/adapters.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node esbuild.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "prepublishOnly": "npm run build && npm run test",
    "demo": "ts-node examples/multi-client.ts"
  },
  "keywords": [
    "state-management",
    "distributed",
    "sync",
    "crdt",
    "real-time",
    "offline-first",
    "conflict-resolution",
    "event-sourcing",
    "undo-redo",
    "react-hooks"
  ],
  "author": "You <you@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/syncwave"
  },
  "bugs": {
    "url": "https://github.com/username/syncwave/issues"
  },
  "homepage": "https://github.com/username/syncwave#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesOptional": {
    "react": true
  }
}
