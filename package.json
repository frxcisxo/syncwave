{
  "name": "@frxncisxo/syncwave",
  "version": "1.0.0",
  "description": "Distributed state management with real-time sync, offline-first, and automatic conflict resolution using CRDTs",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.esm.js",
      "require": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./server": {
      "import": "./dist/server.esm.js",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters.esm.js",
      "require": "./dist/adapters.js",
      "types": "./dist/adapters.d.ts"
    },
    "./sync": {
      "import": "./dist/sync.esm.js",
      "require": "./dist/sync.js",
      "types": "./dist/sync.d.ts"
    },
    "./debugger": {
      "import": "./dist/debugger.esm.js",
      "require": "./dist/debugger.js",
      "types": "./dist/debugger.d.ts"
    },
    "./conflicts": {
      "import": "./dist/conflicts.esm.js",
      "require": "./dist/conflicts.js",
      "types": "./dist/conflicts.d.ts"
    },
    "./encryption": {
      "import": "./dist/encryption.esm.js",
      "require": "./dist/encryption.js",
      "types": "./dist/encryption.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.esm.js",
      "require": "./dist/vue.js",
      "types": "./dist/vue.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte.esm.js",
      "require": "./dist/svelte.js",
      "types": "./dist/svelte.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node esbuild.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "prepublishOnly": "npm run build && npm run test",
    "demo": "tsx examples/multi-client.ts"
  },
  "keywords": [
    "state-management",
    "distributed",
    "sync",
    "crdt",
    "real-time",
    "offline-first",
    "conflict-resolution",
    "event-sourcing",
    "undo-redo",
    "react-hooks"
  ],
  "author": "Fran Cisneros",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frxcisxo/syncwave.git"
  },
  "bugs": {
    "url": "https://github.com/frxcisxo/syncwave/issues"
  },
  "homepage": "https://github.com/frxcisxo/syncwave#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.19.2",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesOptional": {
    "react": true,
    "vue": true
  }
}
